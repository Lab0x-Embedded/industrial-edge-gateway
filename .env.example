# Cloud credentials template -- copy to .env and fill in real values:
#   cp .env.example .env
# .env is git-ignored; CMake parses it at configure time and injects each
# KEY=VALUE as a compiler definition (overriding the placeholders in
# User/net/cloud.h). Rules: KEY=VALUE (everything after the FIRST '='),
# '#' starts a comment, keep comments ASCII-only (CMake file(STRINGS)
# mangles multibyte lines), and avoid quotes/semicolons in values.
# CLOUD_TARGET is an identifier macro: CLOUD_IOTSYSTEM or CLOUD_ONENET,
# no quotes.

# Cloud platform: CLOUD_IOTSYSTEM / CLOUD_ONENET
CLOUD_TARGET=CLOUD_ONENET

# ---- IOTSystem (self-hosted; device must be registered first) ----
IOTSYSTEM_HOST=192.168.0.49
IOTSYSTEM_PRODUCT_KEY=factory_sensor
IOTSYSTEM_DEVICE_ID=dev_001
IOTSYSTEM_DEVICE_SECRET=change-me

# ---- OneNET Studio ----
ONENET_HOST=mqtts.heclouds.com
ONENET_PRODUCT_ID=change-me
ONENET_DEVICE_ID=change-me
# token is generated in the console; et= is the expiry epoch -- when it
# lapses every device drops and the token must be regenerated.
ONENET_TOKEN=version=2018-10-31&res=products%2Fxxx&et=0&method=sha1&sign=xxx
